// VibeCore Framework Starter Kit. ตารางระดับแพลตฟอร์ม (ไม่มี tenant_id): users, permissions, auth_tokens, login_throttles
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ScopeType {
  ALL
  CAMPUS
  ORG_UNIT
}

enum TokenPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(50)
  nameTh    String   @map("name_th") @db.VarChar(255)
  nameEn    String   @map("name_en") @db.VarChar(255)
  logoUrl   String?  @map("logo_url") @db.VarChar(500)
  /// { palette?: "blue"|"coral"|"pink"|"green"|"purple" }
  settings  Json     @default("{}") @db.JsonB
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  userTenants  UserTenant[]
  roles        Role[]
  auditLogs    AuditLog[]
  sampleItems  SampleItem[]
  departments   Department[]
  newsArticles  NewsArticle[]
  staffProfiles StaffProfile[]
  curriculumPrograms CurriculumProgram[]
  documents          EDocument[]
  resources          ResourceItem[]
  reservations       ResourceReservation[]

  @@map("tenants")
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  /// เก็บตัวพิมพ์เล็กเสมอ
  email              String    @unique @db.VarChar(255)
  passwordHash       String?   @map("password_hash") @db.VarChar(255)
  /// ชื่อที่แสดง
  name               String    @db.VarChar(255)
  imageUrl           String?   @map("image_url") @db.VarChar(500)
  /// credentials | google | microsoft
  provider           String    @default("credentials") @db.VarChar(20)
  providerId         String?   @map("provider_id") @db.VarChar(255)
  emailVerified      Boolean   @default(false) @map("email_verified")
  isActive           Boolean   @default(true) @map("is_active")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  /// th | en | null (= ตามเบราว์เซอร์/ค่าเริ่มต้น)
  locale             String?   @db.VarChar(5)
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz()
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  userTenants        UserTenant[]
  authTokens         AuthToken[]
  auditLogs          AuditLog[]            @relation("AuditActor")
  authoredNews       NewsArticle[]         @relation("NewsAuthor")
  staffProfile       StaffProfile?
  submittedDocuments EDocument[]           @relation("DocumentSubmitter")
  documentComments   EDocumentComment[]
  reservations       ResourceReservation[]

  @@map("users")
}

model UserTenant {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  tenantId String   @map("tenant_id") @db.Uuid
  isActive Boolean  @default(true) @map("is_active")
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz()

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles UserRole[]

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@map("user_tenants")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  /// A-Z 0-9 _ เช่น SUPER_ADMIN
  code        String   @db.VarChar(50)
  nameTh      String   @map("name_th") @db.VarChar(100)
  nameEn      String   @map("name_en") @db.VarChar(100)
  description String?  @db.VarChar(500)
  /// แก้สิทธิ์/ลบไม่ได้ · SUPER_ADMIN ได้ทุกสิทธิ์โดยไม่ต้องมีแถวใน role_permissions
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([tenantId, code])
  @@map("roles")
}

/// ผู้ใช้มีได้หลายแถว (หลายบทบาท / บทบาทเดียวหลายขอบเขต) · unique ที่มี scope_id null ไม่กันซ้ำใน Postgres — service ต้องเขียนแบบลบทั้งชุดแล้วสร้างใหม่
model UserRole {
  id           String    @id @default(uuid()) @db.Uuid
  userTenantId String    @map("user_tenant_id") @db.Uuid
  roleId       String    @map("role_id") @db.Uuid
  scopeType    ScopeType @default(ALL) @map("scope_type")
  /// campus_id หรือ org_unit_id หรือขอบเขตอื่นที่กำหนดเพิ่ม — null เมื่อ scope_type = ALL
  scopeId      String?   @map("scope_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  userTenant UserTenant @relation(fields: [userTenantId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userTenantId, roleId, scopeType, scopeId])
  @@index([roleId])
  @@map("user_roles")
}

/// seed จาก src/permissions.ts ทุกครั้ง ไม่แก้ผ่าน UI
model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(100)
  module      String  @db.VarChar(50)
  action      String  @db.VarChar(50)
  description String? @db.VarChar(255)

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// โทเคนใช้ครั้งเดียว — เก็บ sha256 ของโทเคน ไม่เก็บตัวจริง
model AuthToken {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  purpose   TokenPurpose
  tokenHash String       @unique @map("token_hash") @db.VarChar(128)
  /// EMAIL_VERIFY: { newEmail }
  payload   Json?        @db.JsonB
  expiresAt DateTime     @map("expires_at") @db.Timestamptz()
  usedAt    DateTime?    @map("used_at") @db.Timestamptz()
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("auth_tokens")
}

/// กันเดารหัสผ่าน แทน Redis · key = "email:<lower>" หรือ "ip:<addr>"
model LoginThrottle {
  key         String    @id @db.VarChar(320)
  failCount   Int       @default(0) @map("fail_count")
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("login_throttles")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  /// เช่น user.create, user.suspend, role.update
  action    String   @db.VarChar(100)
  entity    String   @db.VarChar(50)
  entityId  String   @map("entity_id") @db.VarChar(64)
  before    Json?    @db.JsonB
  after     Json?    @db.JsonB
  ip        String?  @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User?  @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, entity, entityId])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

/// โมเดลตัวอย่าง (Sample CRUD) สำหรับให้นักเรียนดูเป็นแม่แบบในการพัฒนาฟีเจอร์ใหม่
model SampleItem {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  title       String   @db.VarChar(255)
  description String?  @db.Text
  status      String   @default("ACTIVE") @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("sample_items")
}

enum NewsCategory {
  ACADEMIC
  ACTIVITY
  SCHOLARSHIP
  PROCUREMENT
  GENERAL
}

enum NewsStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// หน่วยงานและภาควิชาในคณะ
model Department {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  code        String   @db.VarChar(50)
  nameTh      String   @map("name_th") @db.VarChar(255)
  nameEn      String   @map("name_en") @db.VarChar(255)
  description String?  @db.Text
  orderIndex  Int      @default(0) @map("order_index")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staffProfiles      StaffProfile[]
  curriculumPrograms CurriculumProgram[]
  documents          EDocument[]
  reservations       ResourceReservation[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("departments")
}

/// ข่าวสารและประกาศประชาสัมพันธ์
model NewsArticle {
  id            String       @id @default(uuid()) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  titleTh       String       @map("title_th") @db.VarChar(500)
  titleEn       String       @map("title_en") @db.VarChar(500)
  slug          String       @db.VarChar(255)
  contentTh     String       @map("content_th") @db.Text
  contentEn     String       @map("content_en") @db.Text
  coverImageUrl String?      @map("cover_image_url") @db.VarChar(1000)
  category      NewsCategory @default(GENERAL)
  status        NewsStatus   @default(DRAFT)
  isPinned      Boolean      @default(false) @map("is_pinned")
  viewCount     Int          @default(0) @map("view_count")
  publishedAt   DateTime?    @map("published_at") @db.Timestamptz()
  expiresAt     DateTime?    @map("expires_at") @db.Timestamptz()
  authorId      String?      @map("author_id") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz()

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  author      User?            @relation("NewsAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  attachments NewsAttachment[]

  @@unique([tenantId, slug])
  @@index([tenantId, status, publishedAt])
  @@index([tenantId, category])
  @@map("news_articles")
}

/// ไฟล์เอกสารแนบประกอบข่าว
model NewsAttachment {
  id        String   @id @default(uuid()) @db.Uuid
  newsId    String   @map("news_id") @db.Uuid
  fileName  String   @map("file_name") @db.VarChar(255)
  fileUrl   String   @map("file_url") @db.VarChar(1000)
  fileSize  Int?     @map("file_size")
  mimeType  String?  @map("mime_type") @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  news NewsArticle @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@index([newsId])
  @@map("news_attachments")
}

enum AcademicRank {
  PROFESSOR
  ASSOC_PROF
  ASST_PROF
  LECTURER
  NONE
}

enum AdminPosition {
  DEAN
  VICE_DEAN
  ASST_DEAN
  HEAD_OF_DEPT
  SECRETARY
  NONE
}

enum PersonnelType {
  ACADEMIC
  SUPPORT
}

/// ข้อมูลและทำเนียบบุคลากร
model StaffProfile {
  id                String        @id @default(uuid()) @db.Uuid
  tenantId          String        @map("tenant_id") @db.Uuid
  departmentId      String?       @map("department_id") @db.Uuid
  userId            String?       @unique @map("user_id") @db.Uuid
  prefixTh          String        @map("prefix_th") @db.VarChar(50)
  prefixEn          String        @map("prefix_en") @db.VarChar(50)
  firstNameTh       String        @map("first_name_th") @db.VarChar(100)
  lastNameTh        String        @map("last_name_th") @db.VarChar(100)
  firstNameEn       String        @map("first_name_en") @db.VarChar(100)
  lastNameEn        String        @map("last_name_en") @db.VarChar(100)
  academicRank      AcademicRank  @default(NONE) @map("academic_rank")
  adminPosition     AdminPosition @default(NONE) @map("admin_position")
  personnelType     PersonnelType @default(ACADEMIC) @map("personnel_type")
  email             String        @db.VarChar(255)
  phone             String?       @db.VarChar(50)
  roomNumber        String?       @map("room_number") @db.VarChar(50)
  avatarUrl         String?       @map("avatar_url") @db.VarChar(1000)
  /// [{ degree: string, field: string, institution: string, year?: number }]
  educationHistory  Json          @default("[]") @map("education_history") @db.JsonB
  /// ["AI", "Data Science", "Machine Learning"]
  expertise         Json          @default("[]") @db.JsonB
  researchInterests String?       @map("research_interests") @db.Text
  orderIndex        Int           @default(0) @map("order_index")
  isActive          Boolean       @default(true) @map("is_active")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz()

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, departmentId])
  @@index([tenantId, personnelType])
  @@index([tenantId, orderIndex])
  @@map("staff_profiles")
}

enum DegreeLevel {
  BACHELOR
  MASTER
  DOCTORATE
  DIPLOMA
}

enum ProgramPlan {
  REGULAR
  SPECIAL
  INTERNATIONAL
  BILINGUAL
}

enum ProgramStatus {
  ACTIVE
  INACTIVE
  REVISED
}

/// ข้อมูลหลักสูตรการศึกษา
model CurriculumProgram {
  id                 String        @id @default(uuid()) @db.Uuid
  tenantId           String        @map("tenant_id") @db.Uuid
  departmentId       String?       @map("department_id") @db.Uuid
  code               String        @db.VarChar(50)
  nameTh             String        @map("name_th") @db.VarChar(255)
  nameEn             String        @map("name_en") @db.VarChar(255)
  degreeTitleTh      String        @map("degree_title_th") @db.VarChar(255)
  degreeTitleEn      String        @map("degree_title_en") @db.VarChar(255)
  degreeAbbrTh       String        @map("degree_abbr_th") @db.VarChar(100)
  degreeAbbrEn       String        @map("degree_abbr_en") @db.VarChar(100)
  degreeLevel        DegreeLevel   @default(BACHELOR) @map("degree_level")
  programPlan        ProgramPlan   @default(REGULAR) @map("program_plan")
  durationYears      Int           @default(4) @map("duration_years")
  totalCredits       Int           @default(120) @map("total_credits")
  tuitionFeeSemester Decimal?      @map("tuition_fee_semester") @db.Decimal(10, 2)
  descriptionTh      String?       @map("description_th") @db.Text
  descriptionEn      String?       @map("description_en") @db.Text
  /// ["Software Engineer", "Data Scientist", "System Analyst"]
  careerPaths        Json          @default("[]") @map("career_paths") @db.JsonB
  /// [{ category: string, credits: number, description?: string }]
  curriculumStructure Json         @default("[]") @map("curriculum_structure") @db.JsonB
  /// [{ year: 1, semester: 1, courses: [{ code: string, name: string, credits: number }] }]
  studyPlan          Json          @default("[]") @map("study_plan") @db.JsonB
  tqfFileUrl         String?       @map("tqf_file_url") @db.VarChar(1000)
  coverImageUrl      String?       @map("cover_image_url") @db.VarChar(1000)
  status             ProgramStatus @default(ACTIVE)
  orderIndex         Int           @default(0) @map("order_index")
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz()

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@unique([tenantId, code])
  @@index([tenantId, departmentId])
  @@index([tenantId, degreeLevel])
  @@index([tenantId, status])
  @@index([tenantId, orderIndex])
  @@map("curriculum_programs")
}

enum DocType {
  PROJECT_PROPOSAL
  OFFICIAL_TRAVEL
  PROCUREMENT_REQ
  GENERAL_REQUEST
}

enum DocUrgency {
  NORMAL
  URGENT
  VERY_URGENT
}

enum DocStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  REVISED_REQUESTED
  CANCELLED
}

enum ApprovalAction {
  PENDING
  APPROVED
  REJECTED
  REVISED_REQUESTED
  SKIPPED
}

/// เอกสารคำร้องอิเล็กทรอนิกส์
model EDocument {
  id             String      @id @default(uuid()) @db.Uuid
  tenantId       String      @map("tenant_id") @db.Uuid
  departmentId   String?     @map("department_id") @db.Uuid
  documentNumber String      @map("document_number") @db.VarChar(100)
  title          String      @db.VarChar(500)
  documentType   DocType     @map("document_type")
  urgency        DocUrgency  @default(NORMAL)
  content        String      @db.Text
  amount         Decimal?    @db.Decimal(12, 2)
  submitterId    String      @map("submitter_id") @db.Uuid
  status         DocStatus   @default(DRAFT)
  currentStep    Int         @default(1) @map("current_step")
  totalSteps     Int         @default(1) @map("total_steps")
  metadata       Json        @default("{}") @db.JsonB
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz()

  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department  Department?           @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  submitter   User                  @relation("DocumentSubmitter", fields: [submitterId], references: [id], onDelete: Cascade)
  approvals   EDocumentApproval[]
  attachments EDocumentAttachment[]
  comments    EDocumentComment[]

  @@unique([tenantId, documentNumber])
  @@index([tenantId, submitterId])
  @@index([tenantId, status])
  @@index([tenantId, documentType])
  @@index([tenantId, departmentId])
  @@map("e_documents")
}

/// ขั้นตอนการพิจารณาอนุมัติคำร้อง
model EDocumentApproval {
  id              String         @id @default(uuid()) @db.Uuid
  documentId      String         @map("document_id") @db.Uuid
  stepOrder       Int            @map("step_order")
  stepNameTh      String         @map("step_name_th") @db.VarChar(200)
  stepNameEn      String         @map("step_name_en") @db.VarChar(200)
  status          ApprovalAction @default(PENDING)
  comment         String?        @db.Text
  approverRole    String?        @map("approver_role") @db.VarChar(100)
  approverUserId  String?        @map("approver_user_id") @db.Uuid
  decidedAt       DateTime?      @map("decided_at") @db.Timestamptz()
  decidedByUserId String?        @map("decided_by_user_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz()

  document EDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, stepOrder])
  @@index([status])
  @@map("e_document_approvals")
}

/// เอกสารแนบประกอบคำร้อง
model EDocumentAttachment {
  id         String   @id @default(uuid()) @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  fileName   String   @map("file_name") @db.VarChar(255)
  fileUrl    String   @map("file_url") @db.VarChar(1000)
  fileSize   Int?     @map("file_size")
  fileType   String?  @map("file_type") @db.VarChar(100)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  document EDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("e_document_attachments")
}

/// ความคิดเห็น/บันทึกข้อความประกอบคำร้อง
model EDocumentComment {
  id         String   @id @default(uuid()) @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  message    String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  document EDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("e_document_comments")
}

enum ResourceType {
  ROOM
  VEHICLE
}

enum ReservationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

/// ทรัพยากรสำหรับใช้งานร่วมกัน (ห้องประชุม/ยานพาหนะ)
model ResourceItem {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  type         ResourceType
  code         String       @db.VarChar(50)
  nameTh       String       @map("name_th") @db.VarChar(255)
  nameEn       String       @map("name_en") @db.VarChar(255)
  description  String?      @db.Text
  capacity     Int          @default(1)
  location     String?      @db.VarChar(255)
  licensePlate String?      @map("license_plate") @db.VarChar(50)
  driverName   String?      @map("driver_name") @db.VarChar(200)
  driverPhone  String?      @map("driver_phone") @db.VarChar(50)
  /// [{ name: "Projector", available: true }, { name: "Video Conference", available: true }]
  amenities    Json         @default("[]") @db.JsonB
  imageUrl     String?      @map("image_url") @db.VarChar(1000)
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz()

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reservations ResourceReservation[]

  @@unique([tenantId, code])
  @@index([tenantId, type])
  @@index([tenantId, isActive])
  @@map("resource_items")
}

/// การจองห้องประชุมและยานพาหนะ
model ResourceReservation {
  id               String            @id @default(uuid()) @db.Uuid
  tenantId         String            @map("tenant_id") @db.Uuid
  resourceId       String            @map("resource_id") @db.Uuid
  userId           String            @map("user_id") @db.Uuid
  departmentId     String?           @map("department_id") @db.Uuid
  title            String            @db.VarChar(255)
  purpose          String?           @db.Text
  attendeesCount   Int               @default(1) @map("attendees_count")
  destination      String?           @db.VarChar(500)
  startTime        DateTime          @map("start_time") @db.Timestamptz()
  endTime          DateTime          @map("end_time") @db.Timestamptz()
  status           ReservationStatus @default(PENDING)
  reviewNotes      String?           @map("review_notes") @db.Text
  reviewedByUserId String?           @map("reviewed_by_user_id") @db.Uuid
  reviewedAt       DateTime?         @map("reviewed_at") @db.Timestamptz()
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz()

  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  resource   ResourceItem  @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([tenantId, resourceId, startTime, endTime])
  @@index([tenantId, userId])
  @@index([tenantId, status])
  @@map("resource_reservations")
}
